{
  "name": "kokoro-plugin",
  "version": "1.0.0",
  "description": "Kokoro TTS local model plugin",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "vite build && node -e \"require('esbuild').buildSync({entryPoints:['src/main.ts'],bundle:true,outfile:'dist/main.cjs',platform:'node',format:'cjs',external:['kokoro-js','@huggingface/transformers'],footer:{js:'module.exports = main_default;'}})\" && node -e \"require('esbuild').buildSync({entryPoints:['src/tts-worker.ts'],bundle:true,outfile:'dist/tts-worker.cjs',platform:'node',format:'cjs',external:['kokoro-js','@huggingface/transformers']})\"",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@agent-qi/types": "workspace:*",
    "@ai-sdk/provider": "catalog:",
    "@ai-sdk/provider-utils": "catalog:",
    "kokoro-js": "^1.2.1",
    "remove-markdown": "^0.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vite": "catalog:"
  },
  "author": "Agent-Qi"
}
