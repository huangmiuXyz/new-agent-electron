{
  "name": "qi-cli",
  "version": "1.0.0",
  "description": "CLI tool for creating and building Qi plugins",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "qi": "dist/index.js"
  },
  "scripts": {
