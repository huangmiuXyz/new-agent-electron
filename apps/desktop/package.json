{
  "name": "desktop",
  "version": "1.0.0",
  "description": "An Electron application with Vue and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:icon:win": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-win-icon.ps1",
    "postinstall": "pnpm rebuild @vscode/ripgrep && pnpm -w rebuild:native",
    "start": "electron-vite preview",
    "dev": "electron-vite dev -- --remote-debugging-port=9222",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "node ./scripts/build-win.mjs",
    "build:win:publish": "node ./scripts/build-win.mjs --publish",
    "build:win:unsigned": "node ./scripts/build-win.mjs --unsigned",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "cap:sync": "node ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "cap:open:android": "node ./node_modules/@capacitor/cli/bin/capacitor open android",
    "cap:build:android": "npm run build && npm run cap:sync && cd android && ./gradlew assembleDebug",
    "cap:build:android:release": "npm run build && npm run cap:sync && cd android && ./gradlew assembleRelease",
    "cap:run:android": "npm run build && npm run cap:sync && cd android && ./gradlew installDebug"
  },
