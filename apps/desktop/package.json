  "build": {
    "appId": "com.electron.app",
    "productName": "agent-qi",
    "directories": {
      "buildResources": "build"
    },
    "afterPack": "./scripts/after-pack.mjs",
    "extraMetadata": {
      "dependencies": {
        "vosk-speech-recognition": null,
        "ollama-starter": null,
        "smart-api-key-filler": null,
        "qi-cli": null
      }
    },
    "files": [
      "out/**",
      "resources/**",
      "!../../packages/**/*",
      "!node_modules/@capacitor",
      "!node_modules/@capacitor/**/*",
      "!node_modules/vosk-speech-recognition",
      "!node_modules/ollama-starter",
      "!node_modules/smart-api-key-filler",
      "!**/.vscode/*",
      "!src/*",
      "!electron.vite.config.{js,ts,mjs,cjs}",
      "!{.eslintcache,eslint.config.mjs,.prettierignore,.prettierrc.yaml,dev-app-update.yml,CHANGELOG.md,README.md}",
      "!{.env,.env.*,.npmrc,pnpm-lock.yaml}",
      "!{tsconfig.json,tsconfig.node.json,tsconfig.web.json}"
    ],
    "asarUnpack": [
      "resources/**",
      "node_modules/sqlite-vec*/**",
      "node_modules/@vscode/ripgrep/bin/**"
    ],
    "win": {
      "executableName": "agent-qi",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "${name}-${version}-setup.${ext}",
      "shortcutName": "${productName}",
      "uninstallDisplayName": "${productName}",
      "createDesktopShortcut": "always",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "extendInfo": {
        "LSUIElement": true,
        "NSCameraUsageDescription": "Application requests access to the device's camera.",
        "NSMicrophoneUsageDescription": "Application requests access to the device's microphone.",
        "NSDocumentsFolderUsageDescription": "Application requests access to the user's Documents folder.",
        "NSDownloadsFolderUsageDescription": "Application requests access to the user's Downloads folder."
      },
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "target": [
        "zip",
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "${name}-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "snap",
        "deb"
      ],
      "maintainer": "electronjs.org",
      "category": "Utility"
    },
    "appImage": {
      "artifactName": "${name}-${version}.${ext}"
    },
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "huangmiuXyz",
      "repo": "new-agent-electron"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}
