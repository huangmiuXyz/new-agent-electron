{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "public/**", "package.json", "tsconfig.json", "vite.config.ts"],
      "outputs": ["dist/**", "out/**"]
    },
    "build:mac": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "build:win": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "build:linux": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "lint": {
      "inputs": ["src/**", "package.json"]
    },
    "typecheck": {
      "inputs": ["src/**", "package.json", "tsconfig.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
