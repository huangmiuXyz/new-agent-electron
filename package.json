{
  "name": "agent-qi",
  "version": "1.0.0",
  "description": "An Electron application with Vue and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "turbo": "turbo dev --filter=!qi-cli",
    "predev": "pnpm taze -w && pnpm --filter @agent-qi/types build",
    "rebuild:native": "node ./node_modules/@electron/rebuild/lib/cli.js -f -w better-sqlite3,node-pty,sqlite-vec,robotjs",
    "dev": "pnpm --filter desktop dev",
    "android:debug": "node ./scripts/build-android.mjs debug",
    "android:release": "node ./scripts/build-android.mjs release",
    "android:bundle": "node ./scripts/build-android.mjs bundle",
    "android:interactive": "node ./scripts/build-android.mjs --interactive",
    "build": "turbo build",
    "build:mac": "turbo build:mac",
    "build:win": "turbo build:win",
    "build:win:publish": "pnpm --filter desktop build:win:publish",
    "build:win:unsigned": "pnpm --filter desktop build:win:unsigned",
    "build:linux": "turbo build:linux",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "taze": "^19.14.1",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.0.16"
    },
    "patchedDependencies": {
      "node-pty@1.1.0": "patches/node-pty@1.1.0.patch"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "vite": "8"
      }
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@vscode/ripgrep",
      "better-sqlite3",
      "node-pty",
      "sqlite-vec",
      "robotjs"
    ]
  },
  "dependencies": {
    "@ai-sdk/moonshotai": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/otel": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "@ai-sdk/vue": "catalog:",
    "@mozilla/readability": "^0.6.0",
    "@openrouter/ai-sdk-provider": "^6.0.0-alpha.1",
    "ai": "catalog:",
    "ai-sdk-ollama": "catalog:",
    "istextorbinary": "^9.5.0",
    "textextensions": "^6.11.0",
    "turndown": "^7.2.4"
  }
}
